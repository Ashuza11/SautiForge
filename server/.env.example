# Copy to server/.env for local development. Never commit the real file.
NODE_ENV=development
PORT=8787
WEB_ORIGIN=http://127.0.0.1:4173

# Use Neon's pooled connection string and require TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Keep this bucket private. Prefer an IAM role in deployment instead of static keys.
AWS_REGION=af-south-1
S3_BUCKET=sautiforge-private-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional for an S3-compatible provider:
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Generate at least 32 random characters. This is a temporary admin boundary,
# not a future volunteer authentication mechanism.
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters
